<Window x:Class="Hanki.App.ShortcutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="단축어"
        Width="540"
        Height="500"
        MinWidth="440"
        MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="단축어 편집" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,18"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="제목 (선택, 최대 120자)" Margin="0,0,0,5"/>
            <TextBox x:Name="TitleBox" MaxLength="120"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="단축어 (1~100자, 대소문자 구분)" Margin="0,0,0,5"/>
            <TextBox x:Name="TriggerBox" MaxLength="100"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBlock Text="변환 문장 (1~10,000자)" Margin="0,0,0,5"/>
            <TextBox x:Name="ReplacementBox" MaxLength="10000"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"/>
            <CheckBox x:Name="FavoriteBox" Content="즐겨찾기" Margin="0,12,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="취소" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Content="저장" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="Hanki.App.ImportConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="중복 단축어 처리"
        Width="470"
        Height="285"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="26">
        <TextBlock Text="중복 단축어를 어떻게 처리할까요?" FontSize="19" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimary}"/>
        <TextBlock Text="단축어 텍스트가 완전히 같은 항목에만 적용됩니다."
                   Foreground="{StaticResource TextSecondary}" Margin="0,7,0,18"/>
        <Button Content="건너뛰기 — 기존 항목 유지" Tag="Skip" Click="Choice_Click"
                HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
        <Button Content="덮어쓰기 — 가져온 항목으로 교체" Tag="Overwrite" Click="Choice_Click"
                HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
        <Button Content="이름 바꾸기 — 새 단축어로 추가" Tag="Rename" Click="Choice_Click"
                HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
        <Button Content="취소" IsCancel="True" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Right"/>
    </StackPanel>
</Window>

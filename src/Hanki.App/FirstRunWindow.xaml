<Window x:Class="Hanki.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="한키 시작하기"
        Width="610"
        Height="550"
        MinWidth="500"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="한키에 오신 것을 환영합니다" FontSize="25" FontWeight="Bold"
                       Foreground="{StaticResource Purple700}"/>
            <TextBlock Text="자주 쓰는 긴 문장을 짧은 단축어로 입력하세요."
                       Foreground="{StaticResource TextSecondary}" Margin="0,7,0,18"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="1. 기본 예제로 바로 시작" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="다른 앱의 입력창에서 ;문의 를 입력하고 Space를 누르세요."
                                   TextWrapping="Wrap" Margin="0,7,0,0"/>
                        <TextBlock Text="안녕하세요. 문의해 주셔서 감사합니다."
                                   Foreground="{StaticResource Purple700}" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="2. 언제든 켜고 끄기" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="창 상단 또는 시스템 트레이 메뉴에서 전체 변환 기능을 켜고 끌 수 있습니다."
                                   TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="3. 입력 내용은 저장하지 않음" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="한키는 네트워크 통신을 하지 않고, 사용자가 입력한 문장과 클립보드를 저장하지 않습니다. 비밀번호 입력창에서는 자동으로 작동을 중단합니다."
                                   TextWrapping="Wrap" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="시작하기" IsDefault="True" Click="StartButton_Click"
                HorizontalAlignment="Right" Margin="0,20,0,0"/>
    </Grid>
</Window>

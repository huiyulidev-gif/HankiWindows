<Window x:Class="Hanki.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="한키"
        Icon="Assets/hanki-logo-64.png"
        Width="1040"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2D2447" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="13" Background="#8E75EA">
                        <Image Source="Assets/hanki-logo-64.png"
                               Width="46" Height="46"
                               AutomationProperties.Name="한키 로고"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Margin="12,1,0,0">
                        <TextBlock Text="한키" Foreground="White" FontWeight="Bold" FontSize="22"/>
                        <TextBlock Text="긴 문장을 한 번에" Foreground="#CCC3E8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#E8E1FA" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="변환 상태: 꺼짐"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                        <Setter Property="Text" Value="변환 상태: 켜짐"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="전체 단축어 변환 켜기/끄기"
                              Width="22" Height="22"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="18,14,18,8"
                    Background="Transparent" BorderThickness="0">
            <TabItem Header="단축어">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="제목, 단축어, 변환 문장 검색"
                                 MinWidth="220"
                                 Margin="0,0,10,0"/>
                        <CheckBox Grid.Column="1" Content="★ 즐겨찾기만"
                                  IsChecked="{Binding FavoritesOnly}"
                                  Margin="4,0,18,0"/>
                        <Button Grid.Column="2" Content="+ 단축어 추가"
                                Command="{Binding AddCommand}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ShortcutsView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Width="30" Height="30" MinHeight="30" Padding="0"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.FavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="즐겨찾기">
                                                <TextBlock Text="★" FontSize="17">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#AAA3B7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Foreground" Value="#F2A900"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <StackPanel Grid.Column="1" Margin="10,0">
                                                <TextBlock Text="제목" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="8,0">
                                                <TextBlock Text="단축어" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                <Border Background="#F1EDFA" CornerRadius="4" Padding="6,2"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding TriggerText}" Foreground="{StaticResource Purple700}"
                                                               FontFamily="Consolas" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="8,0">
                                                <TextBlock Text="변환 문장" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                                <TextBlock Text="{Binding ReplacementText}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ReplacementText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Margin="8,0" HorizontalAlignment="Center">
                                                <TextBlock Text="사용" Foreground="{StaticResource TextSecondary}" FontSize="11"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding UsageCount}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="수정" Margin="0,0,6,0"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="삭제"
                                                        Style="{StaticResource DangerButton}"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="설정">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="일반" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <CheckBox Content="Windows 시작 시 자동 실행"
                                          IsChecked="{Binding Settings.StartWithWindows}"/>
                                <CheckBox Content="창을 닫아도 트레이에서 계속 실행"
                                          IsChecked="{Binding Settings.MinimizeToTray}" Margin="0,12,0,0"/>
                                <CheckBox Content="단축어 변환 일시 정지"
                                          IsChecked="{Binding Settings.IsPaused}" Margin="0,12,0,0"
                                          ToolTip="후크는 유지하고 변환만 잠시 멈춥니다."/>
                                <CheckBox Content="Space로 단축어 변환"
                                          IsChecked="{Binding Settings.SpaceExpansionEnabled}" Margin="0,12,0,0"/>
                                <CheckBox Content="Enter·숫자패드 Enter로 단축어 변환"
                                          IsChecked="{Binding Settings.EnterExpansionEnabled}"
                                          Margin="0,12,0,0"/>
                                <CheckBox Content="Tab으로 단축어 변환"
                                          IsChecked="{Binding Settings.TabExpansionEnabled}"
                                          Margin="0,12,0,0"/>
                                <CheckBox Content="호환성 붙여넣기 모드 (선택 사항 · 기본 OFF)"
                                          IsChecked="{Binding Settings.ClipboardCompatibilityMode}"
                                          Margin="0,12,0,0"
                                          ToolTip="직접 Unicode 입력이 제한된 일반 앱에서만 사용하세요. 비밀번호·제외 대상에서는 동작하지 않습니다."/>
                                <TextBlock Margin="24,6,0,0" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="붙여넣기 모드는 변환문을 잠시 클립보드에 넣은 뒤 복원합니다. 다른 앱이 그 사이 클립보드를 바꾸면 사용자 변경을 덮어쓰지 않습니다. 게임·보안 정책을 우회하지 않습니다."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="제외 프로그램" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,24,0,4"/>
                        <TextBlock Text="프로세스 이름을 한 줄에 하나씩 입력하세요. 메모장과 브라우저는 기본 제외되지 않습니다."
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding ExcludedProcessesText, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True" Height="120"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="제외 사이트" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,24,0,4"/>
                        <TextBlock Text="도메인을 한 줄에 하나씩 입력하세요. 브라우저 주소 전체는 저장하거나 진단 보고서에 넣지 않습니다."
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding ExcludedSitesText, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True" Height="96"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="데이터" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,24,0,10"/>
                        <WrapPanel>
                            <Button Content="JSON 가져오기" Click="ImportButton_Click" Margin="0,0,8,8"/>
                            <Button Content="JSON 내보내기" Click="ExportButton_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            <Button Content="데이터 폴더 열기" Click="OpenDataFolderButton_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                        </WrapPanel>

                        <Border Background="#EEE9FA" CornerRadius="12" Padding="18" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="개인정보 보호" FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource Purple700}"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="단축어와 입력 문장은 이 PC에서만 처리되며 저장하거나 전송하지 않습니다. 비밀번호 입력창에서는 동작하지 않습니다. 사용자가 Google 로그인을 선택한 경우에만 계정 연결을 위한 네트워크 통신이 발생합니다."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="한키 0.2.1-rc.1 · Yulbyte" FontWeight="SemiBold" Margin="0,22,0,0"/>
                        <TextBlock Text="지원: huiyuli.dev@gmail.com"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                        <Button Content="설정 저장" Click="SaveSettingsButton_Click"
                                HorizontalAlignment="Left" Margin="0,20,0,24"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="호환성 진단">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                        <TextBlock Text="호환성 진단" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Margin="0,6,0,14" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}"
                                   Text="이 화면은 ‘키 감지 실패’, ‘입력창 정보 접근 실패’, ‘권한 차이’, ‘문구 주입 실패’를 구분합니다. 보안 프로그램 차단 여부를 임의로 확정하거나 우회하지 않습니다."/>

                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="상태 새로고침" Click="RefreshDiagnosticsButton_Click" Margin="0,0,8,8"/>
                            <Button Content="키 입력 감지 자가 테스트" Click="HookSelfTestButton_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            <Button Content="후크 다시 등록" Click="RestartHookButton_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            <Button Content="진단 ZIP 내보내기" Click="ExportDiagnosticsButton_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding HookSelfTestMessage}" TextWrapping="Wrap"
                                   Foreground="{StaticResource Purple700}" FontWeight="SemiBold" Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="한키 상태" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding DiagnosticAppStatus}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="키보드 후크" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding DiagnosticHookStatus}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DiagnosticHookTimes}" Margin="0,5,0,0"
                                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="현재 입력 대상" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding DiagnosticTargetStatus}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="입력 환경" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding DiagnosticEnvironmentStatus}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Background="#FFF7E8" BorderBrush="#E8C782" BorderThickness="1"
                                CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="마지막 처리 결과" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding DiagnosticProcessingStatus}" Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DiagnosticGuidance}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" Foreground="#704B00"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="내부 변환 테스트" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,8,0,8"/>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="종결자" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Width="150"
                                              ItemsSource="{Binding DiagnosticDelimiterOptions}"
                                              SelectedItem="{Binding DiagnosticTestDelimiter}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource CompatibilityEnumDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="임시 테스트 준비" Click="BeginInternalTestButton_Click"
                                            Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Margin="0,10,0,8" TextWrapping="Wrap"
                                           Text="준비 버튼을 누른 뒤 아래 칸에 ;hankitest 를 입력하고 선택한 종결자 키를 누르세요. 실제 단축어 목록에는 저장되지 않습니다."/>
                                <TextBox x:Name="CompatibilityTestInput"
                                         MinHeight="44"
                                         AutomationProperties.Name="한키 호환성 내부 테스트 입력창"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="권한 차이" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,24,0,8"/>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Text="대상이 더 높은 권한이면 Windows UIPI 정책 때문에 입력이 제한될 수 있습니다. 아래 기능은 사용자가 직접 누른 현재 세션에서만 UAC를 요청하며, 기본 관리자 실행을 설정하지 않습니다."/>
                                <Button Content="이번 세션만 관리자 권한으로 한키 다시 시작"
                                        Click="RestartElevatedButton_Click"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="관리자 실행으로도 게임 보안 모듈이나 PC방 보안 정책의 입력 제한이 해제된다고 보장할 수 없습니다."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="외부 프로그램 수동 확인" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,24,0,8"/>
                        <ItemsControl ItemsSource="{Binding ManualCompatibilityChecks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="250"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding DataContext.ManualCheckStatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Status, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource CompatibilityEnumDisplayConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="최근 진단 이벤트" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,24,0,8"/>
                        <Border Background="#201B2E" CornerRadius="12" Padding="14">
                            <ItemsControl ItemsSource="{Binding RecentDiagnosticEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#EDE8FA"
                                                   FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Border Background="#EEE9FA" CornerRadius="12" Padding="16" Margin="0,16,0,24">
                            <TextBlock TextWrapping="Wrap"
                                       Text="진단 보고서에는 UTC 시각, 앱·Windows 버전, 실행 파일명(경로 제외), 무결성·후크·IME·레이아웃 상태, 종결자 종류, 단계별 요청/성공 수와 열거형 사유만 포함됩니다. 키 입력, 단축어·변환문, 클립보드, 창 제목, 사용자 이름과 전체 경로는 포함하지 않습니다."/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="계정">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AccountTabRoot" MaxWidth="780" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Image Source="Assets/hanki-logo-64.png" Width="32" Height="32"
                                   AutomationProperties.Name="한키 로고"
                                   Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="계정" FontSize="20" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRestoring}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding RestoreInProgressMessage}"
                                               Foreground="{StaticResource TextPrimary}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <ProgressBar IsIndeterminate="True" Height="5" Margin="0,12,0,0"
                                                 AutomationProperties.Name="로그인 상태 확인 중"/>
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoggedOut}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding LoggedOutDescriptionPrimary}"
                                               Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding LoggedOutDescriptionSecondary}"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,4,0,14"/>
                                    <Button Content="Google로 로그인"
                                            Command="{Binding LoginCommand}"
                                            IsEnabled="{Binding CanStartLogin}"
                                            ToolTip="{Binding LoginTooltip}"
                                            IsDefault="True"
                                            AutomationProperties.Name="Google 계정으로 로그인"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoggingIn}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding InProgressMessage}"
                                               Foreground="{StaticResource TextPrimary}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <ProgressBar IsIndeterminate="True" Height="5" Margin="0,12,0,14"
                                                 AutomationProperties.Name="Google 로그인 진행 중"/>
                                    <Button Content="취소" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding CancelCommand}"
                                            AutomationProperties.HelpText="Escape 키로도 로그인을 취소할 수 있습니다."
                                            HorizontalAlignment="Left"/>
                                </StackPanel>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26"
                                                Background="#EEE9F8" Margin="0,0,14,0" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="&#128100;" FontSize="24"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowDefaultAvatar}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Image Source="{Binding AvatarImage}" Width="52" Height="52"
                                                       AutomationProperties.Name="Google 계정 프로필 이미지"
                                                       Stretch="UniformToFill">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowDefaultAvatar}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="16"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding UserName}"/>
                                            <TextBlock Text="{Binding UserEmail}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding UserEmail}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="로그아웃" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding LogoutCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                                </StackPanel>

                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42345" TextWrapping="Wrap"
                                           Margin="0,14,0,0"
                                           AutomationProperties.LiveSetting="Assertive"
                                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding NoticeMessage}" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="{Binding NoticeMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#EEE9FA" CornerRadius="12" Padding="18" Margin="0,18,0,24">
                            <StackPanel>
                                <TextBlock Text="개인정보 보호" FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource Purple700}"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="이름·이메일·프로필 이미지와 로그인 토큰은 계정 표시와 로그인 유지에만 사용됩니다. 토큰은 Windows 계정에 묶어 이 PC에 암호화 저장합니다. 단축어는 계속 로컬에만 저장되며 현재 클라우드 동기화하지 않습니다."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#EEE9F8" Padding="18,9">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
